# Copy to .env (git-ignored). k3s uses these to pull the echo-api image.
# REGISTRY_HOST must match the REGISTRY repository variable used by CI,
# e.g. registry.example.com, registry.example.com:5000, or docker.io for Docker Hub.
REGISTRY_HOST=registry.example.com
REGISTRY_USERNAME=
# Password or access token with pull access.
REGISTRY_PASSWORD=
